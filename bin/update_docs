#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "open3"
require "rbconfig"

ROOT = File.expand_path("..", __dir__)
TMP = File.join(ROOT, "tmp", "benchmark")
BENCHMARK_JSON = File.join(TMP, "results.json")
AURORA_JSON = File.join(TMP, "second_provider.json")
SPEC_ONLY_JSON = File.join(ROOT, "research", "spec_only_novapay_report.json")
THIRD_PROVIDER_JSON = File.join(TMP, "third_provider.json")
RSPEC_JSON = File.join(TMP, "rspec.json")

def run_ruby(environment, *arguments)
  stdout, stderr, status = Open3.capture3(environment, RbConfig.ruby, *arguments, chdir: ROOT)
  return if status.success?

  warn stdout
  warn stderr
  abort "command failed: ruby #{arguments.join(" ")}"
end

def read_json(path)
  JSON.parse(File.read(path, encoding: "UTF-8"))
end

def percent(value)
  value.nil? ? "n/a" : "#{value}%"
end

def decision_metrics(metrics)
  decision = metrics.fetch("decision_level")
  "#{decision.fetch("accepted_decisions")}/#{decision.fetch("total_decisions")} (#{percent(decision["decision_automation_rate"])})"
end

def review_metrics(metrics)
  decision = metrics.fetch("decision_level")
  "#{decision.fetch("review_required_decisions")}/#{decision.fetch("total_decisions")} (#{percent(decision["review_rate"])})"
end

def full_ready_metrics(metrics)
  spec = metrics.fetch("spec_level")
  "#{spec.fetch("fully_auto_ready_specs")}/#{spec.fetch("total_specs")} (#{percent(spec["fully_auto_ready_rate"])})"
end

def safety_metrics(metrics)
  safety = metrics.fetch("safety")
  "false ACCEPTs #{safety.fetch("critical_false_accepts")}; unsafe generation attempts #{safety.fetch("unsafe_generation_attempts")}"
end

def replace_block(path, name, content)
  source = File.read(path, encoding: "UTF-8")
  start_marker = "<!-- BEGIN GENERATED: #{name} -->"
  end_marker = "<!-- END GENERATED: #{name} -->"
  pattern = /#{Regexp.escape(start_marker)}.*?#{Regexp.escape(end_marker)}/m
  abort "missing or duplicate generated block #{name} in #{path}" unless source.scan(pattern).length == 1

  replacement = "#{start_marker}\n#{content.rstrip}\n#{end_marker}"
  File.write(path, source.sub(pattern, replacement), encoding: "UTF-8")
end

FileUtils.mkdir_p(TMP)
run_ruby({ "BENCHMARK_OUTPUT" => BENCHMARK_JSON }, "research/benchmark/run.rb")
run_ruby({ "SECOND_PROVIDER_OUTPUT" => AURORA_JSON }, "research/benchmark/second_provider.rb")
run_ruby({ "SPEC_ONLY_OUTPUT" => SPEC_ONLY_JSON }, "research/benchmark/spec_only.rb")
run_ruby({ "THIRD_PROVIDER_OUTPUT" => THIRD_PROVIDER_JSON }, "research/benchmark/third_provider.rb")
run_ruby({}, "-rbundler/setup", "-S", "rspec", "--format", "json", "--out", RSPEC_JSON)

benchmark = read_json(BENCHMARK_JSON)
aurora = read_json(AURORA_JSON)
spec_only = read_json(SPEC_ONLY_JSON)
third_provider = read_json(THIRD_PROVIDER_JSON)
rspec = read_json(RSPEC_JSON)

# RSpec's JSON formatter includes wall-clock timing. Remove it so a second
# updater run produces the same documentation snapshot.
rspec.fetch("examples", []).each { |example| example.delete("run_time") }
rspec.fetch("summary", {}).delete("duration")
File.write(RSPEC_JSON, JSON.pretty_generate(rspec) + "\n", encoding: "UTF-8")

aggregate = benchmark.fetch("aggregate")
aurora_aggregate = aurora.fetch("aggregate")
spec_only_baseline = spec_only.fetch("baseline")
spec_only_aggregate = spec_only.fetch("aggregate")
third_aggregate = third_provider.fetch("aggregate")
third_spec_only = third_aggregate.fetch("spec_only")
third_resolved = third_aggregate.fetch("resolved")
rspec_summary = rspec.fetch("summary")
aurora_vectors = aurora_aggregate.fetch("resolved").fetch("behavioral_vectors").fetch("vectors")
aurora_vectors_total = aurora_vectors.length
aurora_vectors_passed = aurora_vectors.count { |vector| vector.fetch("passed") }
example_files = Dir[File.join(ROOT, "examples", "novapay", "*")].select { |path| File.file?(path) }.map { |path| File.basename(path) }.sort

baseline_metrics = spec_only_baseline.fetch("metrics")
spec_only_metrics = spec_only_aggregate.fetch("metrics")
aurora_spec_metrics = aurora_aggregate.fetch("pure_generic").fetch("metrics")
aurora_resolved_metrics = aurora_aggregate.fetch("resolved").fetch("metrics")
helios_spec_metrics = third_spec_only.fetch("metrics")
helios_resolved_metrics = third_resolved.fetch("metrics")

status_block = <<~MARKDOWN
  **Current verification snapshot (generated)**

  - RSpec: #{rspec_summary.fetch("example_count")} examples, failures: #{rspec_summary.fetch("failure_count")}.
  - Reference mutation benchmark: #{aggregate.fetch("cases_passed")}/#{aggregate.fetch("cases_total")} adversarial mutations of one reference provider domain; semantic accuracy: #{percent(aggregate["semantic_accept_accuracy"])}; critical false ACCEPTs: #{aggregate.fetch("critical_false_accept_count")}.
  - NovaPay official spec-only baseline: decision automation #{decision_metrics(baseline_metrics)}; review rate #{review_metrics(baseline_metrics)}; fully auto-ready #{full_ready_metrics(baseline_metrics)}; #{safety_metrics(baseline_metrics)}.
  - NovaPay spec-only mutation lane: decision automation #{decision_metrics(spec_only_metrics)}; review rate #{review_metrics(spec_only_metrics)}; fully auto-ready #{full_ready_metrics(spec_only_metrics)}; #{safety_metrics(spec_only_metrics)}.
  - Aurora spec-only: decision automation #{decision_metrics(aurora_spec_metrics)}; fully auto-ready #{full_ready_metrics(aurora_spec_metrics)}. Aurora resolved: #{full_ready_metrics(aurora_resolved_metrics)}; behavioral vectors #{aurora_vectors_passed}/#{aurora_vectors_total}.
  - HeliosPay spec-only: decision automation #{decision_metrics(helios_spec_metrics)}; fully auto-ready #{full_ready_metrics(helios_spec_metrics)}. Resolved: #{full_ready_metrics(helios_resolved_metrics)}; behavioral vectors #{third_resolved.dig("behavioral_vectors", "passed_count")}/#{third_resolved.dig("behavioral_vectors", "count")}.

  Run `ruby bin/update_docs` to refresh this snapshot from the benchmark and RSpec outputs.
MARKDOWN

capabilities_block = <<~MARKDOWN
  - OpenAPI ingestion, local reference resolution and source fingerprinting are implemented in `lib/provider_compiler/core.rb`.
  - Evidence-aware analysis, Review Manifest and Provider Blueprint are implemented across the analyzer/profile/blueprint layers.
  - Deterministic Ruby projection and verification are implemented by the generator and verification layers.
  - Canonical NovaPay example: #{example_files.length} files in `examples/novapay/` (`#{example_files.join("`, `")}`).
  - Independent semantic validation: the NovaPay mutation benchmark and Aurora/Helios comparisons are included in the generated status below.
  - Live provider calls are not implemented; the Web UI Demo Workbench is implemented in `lib/provider_compiler/web.rb`, `lib/provider_compiler/web_renderer.rb` and `web/public/`.

  Run `ruby bin/update_docs` to refresh this snapshot.
MARKDOWN

judge_metrics_block = <<~MARKDOWN
  | Lane | Decision automation | Review rate | Fully auto-ready | Safety |
  |---|---:|---:|---:|---|
  | NovaPay official spec-only | #{decision_metrics(baseline_metrics)} | #{review_metrics(baseline_metrics)} | #{full_ready_metrics(baseline_metrics)} | #{safety_metrics(baseline_metrics)} |
  | NovaPay spec-only mutation lane (7 cases) | #{decision_metrics(spec_only_metrics)} | #{review_metrics(spec_only_metrics)} | #{full_ready_metrics(spec_only_metrics)} | #{safety_metrics(spec_only_metrics)} |
  | Aurora spec-only | #{decision_metrics(aurora_spec_metrics)} | #{review_metrics(aurora_spec_metrics)} | #{full_ready_metrics(aurora_spec_metrics)} | #{safety_metrics(aurora_spec_metrics)} |
  | Aurora resolved | #{decision_metrics(aurora_resolved_metrics)} | #{review_metrics(aurora_resolved_metrics)} | #{full_ready_metrics(aurora_resolved_metrics)} | #{safety_metrics(aurora_resolved_metrics)} |
  | HeliosPay spec-only | #{decision_metrics(helios_spec_metrics)} | #{review_metrics(helios_spec_metrics)} | #{full_ready_metrics(helios_spec_metrics)} | #{safety_metrics(helios_spec_metrics)} |
  | HeliosPay resolved | #{decision_metrics(helios_resolved_metrics)} | #{review_metrics(helios_resolved_metrics)} | #{full_ready_metrics(helios_resolved_metrics)} | #{safety_metrics(helios_resolved_metrics)} |

  Decision automation is an accepted-decision metric, not a readiness claim. Full-spec auto-ready means a complete spec has zero `REVIEW_REQUIRED` decisions and zero blocking entries. Blocking is reported separately because one decision may produce multiple blocking entries. The benchmark also reports generation/runtime gates where generation is attempted.
MARKDOWN

benchmark_block = <<~MARKDOWN
  **Reference mutation benchmark**

  - Scope: #{aggregate.fetch("cases_total")} adversarial mutations of one reference provider domain, not #{aggregate.fetch("cases_total")} providers.
  - Independent decision/semantic cases passed: #{aggregate.fetch("cases_passed")}/#{aggregate.fetch("cases_total")}.
  - Decision accuracy: #{percent(aggregate["decision_accuracy"])}; semantic ACCEPT accuracy: #{percent(aggregate["semantic_accept_accuracy"])}.
  - Semantic areas (operation / money / status / auth / webhook / idempotency / field mapping): #{%w[operation_semantic_accuracy money_semantic_accuracy status_semantic_accuracy auth_semantic_accuracy webhook_semantic_accuracy idempotency_semantic_accuracy field_mapping_semantic_accuracy].map { |key| percent(aggregate[key]) }.join(" / ")}.
  - Critical false ACCEPTs: #{aggregate.fetch("critical_false_accept_count")}; generation: #{aggregate.fetch("generation_pass_count")}/#{aggregate.fetch("generation_attempt_count")} attempts passed.

  **Spec-only lanes**

  - NovaPay official baseline: decision automation #{decision_metrics(baseline_metrics)}; review rate #{review_metrics(baseline_metrics)}; blocking entries #{baseline_metrics.dig("decision_level", "blocking_entries")}; fully auto-ready #{full_ready_metrics(baseline_metrics)}; #{safety_metrics(baseline_metrics)}.
  - NovaPay mutation lane: #{spec_only_aggregate.fetch("cases_total")} cases, #{spec_only_aggregate.dig("metrics", "decision_level", "total_decisions")} decisions; decision automation #{decision_metrics(spec_only_metrics)}; review rate #{review_metrics(spec_only_metrics)}; blocking entries #{spec_only_metrics.dig("decision_level", "blocking_entries")}; fully auto-ready #{full_ready_metrics(spec_only_metrics)}; #{safety_metrics(spec_only_metrics)}.
  - Aurora: spec-only decision automation #{decision_metrics(aurora_spec_metrics)}, fully auto-ready #{full_ready_metrics(aurora_spec_metrics)}; resolved fully auto-ready #{full_ready_metrics(aurora_resolved_metrics)}; behavioral vectors #{aurora_vectors_passed}/#{aurora_vectors_total}.
  - HeliosPay: spec-only decision automation #{decision_metrics(helios_spec_metrics)}, fully auto-ready #{full_ready_metrics(helios_spec_metrics)}; resolved fully auto-ready #{full_ready_metrics(helios_resolved_metrics)}; behavioral vectors #{third_resolved.dig("behavioral_vectors", "passed_count")}/#{third_resolved.dig("behavioral_vectors", "count")}.

  Legacy `automatic_coverage` remains in machine results for historical comparison only. It is not a judge-facing automation or safety metric.
MARKDOWN

baseline_block = <<~MARKDOWN
  **Official input**: `fixtures/novapay_provider_api.yaml`
  **Host profile**: `profiles/space_payments_v1.yml`
  **Provider defaults**: none (spec-only)

  | Metric | Result |
  |---|---:|
  | Total decisions | #{baseline_metrics.dig("decision_level", "total_decisions")} |
  | Accepted decisions | #{baseline_metrics.dig("decision_level", "accepted_decisions")} |
  | Review-required decisions | #{baseline_metrics.dig("decision_level", "review_required_decisions")} (#{percent(baseline_metrics.dig("decision_level", "review_rate"))}) |
  | Blocking entries | #{baseline_metrics.dig("decision_level", "blocking_entries")} |
  | Decision automation | #{decision_metrics(baseline_metrics)} |
  | Fully auto-ready | #{full_ready_metrics(baseline_metrics)} |
  | Critical false ACCEPTs | #{baseline_metrics.dig("safety", "critical_false_accepts")} |
  | Unsafe generation attempts | #{baseline_metrics.dig("safety", "unsafe_generation_attempts")} |

  Automatic facts are accepted only where the official specification provides sufficient evidence. Remaining review concerns are preserved in the Review Manifest; the spec-only run does not generate an adapter.
MARKDOWN

replace_block(File.join(ROOT, "README.md"), "PROJECT_STATUS", status_block)
replace_block(File.join(ROOT, "README.md"), "CAPABILITIES", capabilities_block)
replace_block(File.join(ROOT, "README.md"), "JUDGE_METRICS", judge_metrics_block)
replace_block(File.join(ROOT, "docs", "BENCHMARK.md"), "BENCHMARK", benchmark_block)
replace_block(File.join(ROOT, "research", "NOVAPAY_SPEC_ONLY_BASELINE.md"), "NOVAPAY_SPEC_ONLY_BASELINE", baseline_block)
puts "Judge-facing metrics and generated documentation updated"
