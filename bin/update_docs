#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "open3"
require "rbconfig"

ROOT = File.expand_path("..", __dir__)
TMP = File.join(ROOT, "tmp", "benchmark")
BENCHMARK_JSON = File.join(TMP, "results.json")
AURORA_JSON = File.join(TMP, "second_provider.json")
SPEC_ONLY_JSON = File.join(ROOT, "research", "spec_only_novapay_report.json")
THIRD_PROVIDER_JSON = File.join(TMP, "third_provider.json")
RSPEC_JSON = File.join(TMP, "rspec.json")

def run_ruby(environment, *arguments)
  stdout, stderr, status = Open3.capture3(environment, RbConfig.ruby, *arguments, chdir: ROOT)
  return if status.success?

  warn stdout
  warn stderr
  abort "command failed: ruby #{arguments.join(" ")}"
end

def read_json(path)
  JSON.parse(File.read(path, encoding: "UTF-8"))
end

def percent(value)
  value.nil? ? "n/a" : "#{value}%"
end

def decision_metrics(metrics)
  decision = metrics.fetch("decision_level")
  "#{decision.fetch("accepted_decisions")}/#{decision.fetch("total_decisions")} (#{percent(decision["decision_automation_rate"])})"
end

def review_metrics(metrics)
  decision = metrics.fetch("decision_level")
  "#{decision.fetch("review_required_decisions")}/#{decision.fetch("total_decisions")} (#{percent(decision["review_rate"])})"
end

def full_ready_metrics(metrics)
  spec = metrics.fetch("spec_level")
  "#{spec.fetch("fully_auto_ready_specs")}/#{spec.fetch("total_specs")} (#{percent(spec["fully_auto_ready_rate"])})"
end

def safety_metrics(metrics)
  safety = metrics.fetch("safety")
  "критических ложных ACCEPT #{safety.fetch("critical_false_accepts")}; попыток небезопасной генерации #{safety.fetch("unsafe_generation_attempts")}"
end

def replace_block(path, name, content)
  source = File.read(path, encoding: "UTF-8")
  start_marker = "<!-- BEGIN GENERATED: #{name} -->"
  end_marker = "<!-- END GENERATED: #{name} -->"
  pattern = /#{Regexp.escape(start_marker)}.*?#{Regexp.escape(end_marker)}/m
  abort "missing or duplicate generated block #{name} in #{path}" unless source.scan(pattern).length == 1

  replacement = "#{start_marker}\n#{content.rstrip}\n#{end_marker}"
  File.write(path, source.sub(pattern, replacement), encoding: "UTF-8")
end

FileUtils.mkdir_p(TMP)
run_ruby({ "BENCHMARK_OUTPUT" => BENCHMARK_JSON }, "research/benchmark/run.rb")
run_ruby({ "SECOND_PROVIDER_OUTPUT" => AURORA_JSON }, "research/benchmark/second_provider.rb")
run_ruby({ "SPEC_ONLY_OUTPUT" => SPEC_ONLY_JSON }, "research/benchmark/spec_only.rb")
run_ruby({ "THIRD_PROVIDER_OUTPUT" => THIRD_PROVIDER_JSON }, "research/benchmark/third_provider.rb")
run_ruby({}, "-rbundler/setup", "-S", "rspec", "--format", "json", "--out", RSPEC_JSON)

benchmark = read_json(BENCHMARK_JSON)
aurora = read_json(AURORA_JSON)
spec_only = read_json(SPEC_ONLY_JSON)
third_provider = read_json(THIRD_PROVIDER_JSON)
rspec = read_json(RSPEC_JSON)

# RSpec's JSON formatter includes wall-clock timing. Remove it so a second
# updater run produces the same documentation snapshot.
rspec.fetch("examples", []).each { |example| example.delete("run_time") }
rspec.fetch("summary", {}).delete("duration")
File.write(RSPEC_JSON, JSON.pretty_generate(rspec) + "\n", encoding: "UTF-8")

aggregate = benchmark.fetch("aggregate")
aurora_aggregate = aurora.fetch("aggregate")
spec_only_baseline = spec_only.fetch("baseline")
spec_only_aggregate = spec_only.fetch("aggregate")
third_aggregate = third_provider.fetch("aggregate")
third_spec_only = third_aggregate.fetch("spec_only")
third_resolved = third_aggregate.fetch("resolved")
rspec_summary = rspec.fetch("summary")
aurora_vectors = aurora_aggregate.fetch("resolved").fetch("behavioral_vectors").fetch("vectors")
aurora_vectors_total = aurora_vectors.length
aurora_vectors_passed = aurora_vectors.count { |vector| vector.fetch("passed") }
example_files = Dir[File.join(ROOT, "examples", "novapay", "*")].select { |path| File.file?(path) }.map { |path| File.basename(path) }.sort

baseline_metrics = spec_only_baseline.fetch("metrics")
spec_only_metrics = spec_only_aggregate.fetch("metrics")
aurora_spec_metrics = aurora_aggregate.fetch("pure_generic").fetch("metrics")
aurora_resolved_metrics = aurora_aggregate.fetch("resolved").fetch("metrics")
helios_spec_metrics = third_spec_only.fetch("metrics")
helios_resolved_metrics = third_resolved.fetch("metrics")

status_block = <<~MARKDOWN
  **Текущий снимок проверки (сгенерировано)**

  - RSpec: #{rspec_summary.fetch("example_count")} примеров, ошибок: #{rspec_summary.fetch("failure_count")}.
  - Reference mutation benchmark: #{aggregate.fetch("cases_passed")}/#{aggregate.fetch("cases_total")} adversarial-мутаций одного домена эталонного провайдера; точность семантики: #{percent(aggregate["semantic_accept_accuracy"])}; критических ложных ACCEPT: #{aggregate.fetch("critical_false_accept_count")}.
  - Официальный NovaPay spec-only baseline: автоматизация решений #{decision_metrics(baseline_metrics)}; доля review #{review_metrics(baseline_metrics)}; полностью готовых автоматически #{full_ready_metrics(baseline_metrics)}; #{safety_metrics(baseline_metrics)}.
  - NovaPay spec-only mutation lane: автоматизация решений #{decision_metrics(spec_only_metrics)}; доля review #{review_metrics(spec_only_metrics)}; полностью готовых автоматически #{full_ready_metrics(spec_only_metrics)}; #{safety_metrics(spec_only_metrics)}.
  - Aurora spec-only: автоматизация решений #{decision_metrics(aurora_spec_metrics)}; полностью готовых автоматически #{full_ready_metrics(aurora_spec_metrics)}. Aurora после разрешения: #{full_ready_metrics(aurora_resolved_metrics)}; behavioral vectors #{aurora_vectors_passed}/#{aurora_vectors_total}.
  - HeliosPay spec-only: автоматизация решений #{decision_metrics(helios_spec_metrics)}; полностью готовых автоматически #{full_ready_metrics(helios_spec_metrics)}. После разрешения: #{full_ready_metrics(helios_resolved_metrics)}; behavioral vectors #{third_resolved.dig("behavioral_vectors", "passed_count")}/#{third_resolved.dig("behavioral_vectors", "count")}.

  Выполните `ruby bin/update_docs`, чтобы обновить этот снимок по результатам benchmark и RSpec.
MARKDOWN

capabilities_block = <<~MARKDOWN
  - Загрузка OpenAPI, разрешение локальных ссылок и fingerprint источника реализованы в `lib/provider_compiler/core.rb`.
  - Анализ с учётом доказательств, `Review Manifest` и `Provider Blueprint` реализованы в слоях analyzer/profile/blueprint.
  - Детерминированная Ruby-проекция и проверка результата реализованы в слоях generator и verification.
  - Канонический пример NovaPay: #{example_files.length} файлов в `examples/novapay/` (`#{example_files.join("`, `")}`).
  - Независимая проверка семантики: benchmark мутаций NovaPay и сравнения Aurora/Helios включены в сгенерированный статус ниже.
  - Live-вызовы реального платёжного провайдера не выполняются; transport сгенерированного adapter проверяется через локальный HTTP E2E без внешней сети. Локальный Web UI Demo Workbench реализован в `lib/provider_compiler/web.rb`, `lib/provider_compiler/web_renderer.rb` и `web/public/`.

  Выполните `ruby bin/update_docs`, чтобы обновить этот снимок.
MARKDOWN

judge_metrics_block = <<~MARKDOWN
  | Прогон | Автоматизация решений | Доля review | Полностью готово автоматически | Безопасность |
  |---|---:|---:|---:|---|
  | Официальный NovaPay spec-only | #{decision_metrics(baseline_metrics)} | #{review_metrics(baseline_metrics)} | #{full_ready_metrics(baseline_metrics)} | #{safety_metrics(baseline_metrics)} |
  | NovaPay mutation lane (7 кейсов) | #{decision_metrics(spec_only_metrics)} | #{review_metrics(spec_only_metrics)} | #{full_ready_metrics(spec_only_metrics)} | #{safety_metrics(spec_only_metrics)} |
  | Aurora spec-only | #{decision_metrics(aurora_spec_metrics)} | #{review_metrics(aurora_spec_metrics)} | #{full_ready_metrics(aurora_spec_metrics)} | #{safety_metrics(aurora_spec_metrics)} |
  | Aurora после разрешения | #{decision_metrics(aurora_resolved_metrics)} | #{review_metrics(aurora_resolved_metrics)} | #{full_ready_metrics(aurora_resolved_metrics)} | #{safety_metrics(aurora_resolved_metrics)} |
  | HeliosPay spec-only | #{decision_metrics(helios_spec_metrics)} | #{review_metrics(helios_spec_metrics)} | #{full_ready_metrics(helios_spec_metrics)} | #{safety_metrics(helios_spec_metrics)} |
  | HeliosPay после разрешения | #{decision_metrics(helios_resolved_metrics)} | #{review_metrics(helios_resolved_metrics)} | #{full_ready_metrics(helios_resolved_metrics)} | #{safety_metrics(helios_resolved_metrics)} |

  Автоматизация решений — это метрика принятых решений, а не заявление о готовности. Полная автоматическая готовность означает, что спецификация не содержит решений `REVIEW_REQUIRED` и blocking-записей. Blocking считается отдельно, потому что одно решение может породить несколько blocking-записей. Benchmark также сообщает о контрольных точках генерации и runtime там, где генерация запускалась.
MARKDOWN

benchmark_block = <<~MARKDOWN
  **Эталонный benchmark мутаций**

  - Область: #{aggregate.fetch("cases_total")} adversarial-мутаций одного домена эталонного провайдера, а не #{aggregate.fetch("cases_total")} провайдеров.
  - Независимые decision/semantic-кейсы пройдены: #{aggregate.fetch("cases_passed")}/#{aggregate.fetch("cases_total")}.
  - Точность решений: #{percent(aggregate["decision_accuracy"])}; точность semantic ACCEPT: #{percent(aggregate["semantic_accept_accuracy"])}.
  - Семантические области (operation / money / status / auth / webhook / idempotency / field mapping): #{%w[operation_semantic_accuracy money_semantic_accuracy status_semantic_accuracy auth_semantic_accuracy webhook_semantic_accuracy idempotency_semantic_accuracy field_mapping_semantic_accuracy].map { |key| percent(aggregate[key]) }.join(" / ")}.
  - Критических ложных ACCEPT: #{aggregate.fetch("critical_false_accept_count")}; генерация: #{aggregate.fetch("generation_pass_count")}/#{aggregate.fetch("generation_attempt_count")} попыток пройдены.

  **Прогоны только по спецификации**

  - Официальный NovaPay baseline: автоматизация решений #{decision_metrics(baseline_metrics)}; доля review #{review_metrics(baseline_metrics)}; blocking-записей #{baseline_metrics.dig("decision_level", "blocking_entries")}; полностью готовых автоматически #{full_ready_metrics(baseline_metrics)}; #{safety_metrics(baseline_metrics)}.
  - NovaPay mutation lane: #{spec_only_aggregate.fetch("cases_total")} кейсов, #{spec_only_aggregate.dig("metrics", "decision_level", "total_decisions")} решений; автоматизация решений #{decision_metrics(spec_only_metrics)}; доля review #{review_metrics(spec_only_metrics)}; blocking-записей #{spec_only_metrics.dig("decision_level", "blocking_entries")}; полностью готовых автоматически #{full_ready_metrics(spec_only_metrics)}; #{safety_metrics(spec_only_metrics)}.
  - Aurora: автоматизация решений только по спецификации #{decision_metrics(aurora_spec_metrics)}, полностью готовых автоматически #{full_ready_metrics(aurora_spec_metrics)}; после разрешения полностью готовых автоматически #{full_ready_metrics(aurora_resolved_metrics)}; behavioral vectors #{aurora_vectors_passed}/#{aurora_vectors_total}.
  - HeliosPay: автоматизация решений только по спецификации #{decision_metrics(helios_spec_metrics)}, полностью готовых автоматически #{full_ready_metrics(helios_spec_metrics)}; после разрешения полностью готовых автоматически #{full_ready_metrics(helios_resolved_metrics)}; behavioral vectors #{third_resolved.dig("behavioral_vectors", "passed_count")}/#{third_resolved.dig("behavioral_vectors", "count")}.

  Legacy `automatic_coverage` остаётся в machine results только для исторического сравнения. Это не judge-facing метрика автоматизации или безопасности.
MARKDOWN

baseline_block = <<~MARKDOWN
  **Официальный вход**: `fixtures/novapay_provider_api.yaml`
  **Профиль хоста**: `profiles/space_payments_v1.yml`
  **Provider defaults**: отсутствуют (spec-only)

  | Метрика | Результат |
  |---|---:|
  | Всего решений | #{baseline_metrics.dig("decision_level", "total_decisions")} |
  | Принятые решения | #{baseline_metrics.dig("decision_level", "accepted_decisions")} |
  | Решения, требующие review | #{baseline_metrics.dig("decision_level", "review_required_decisions")} (#{percent(baseline_metrics.dig("decision_level", "review_rate"))}) |
  | Blocking-записи | #{baseline_metrics.dig("decision_level", "blocking_entries")} |
  | Автоматизация решений | #{decision_metrics(baseline_metrics)} |
  | Полностью готово автоматически | #{full_ready_metrics(baseline_metrics)} |
  | Критические ложные ACCEPT | #{baseline_metrics.dig("safety", "critical_false_accepts")} |
  | Попытки небезопасной генерации | #{baseline_metrics.dig("safety", "unsafe_generation_attempts")} |

  Автоматические факты принимаются только там, где официальная спецификация даёт достаточные доказательства. Остальные вопросы сохраняются в Review Manifest; spec-only прогон не генерирует адаптер.
MARKDOWN

replace_block(File.join(ROOT, "README.md"), "PROJECT_STATUS", status_block)
replace_block(File.join(ROOT, "README.md"), "CAPABILITIES", capabilities_block)
replace_block(File.join(ROOT, "README.md"), "JUDGE_METRICS", judge_metrics_block)
replace_block(File.join(ROOT, "docs", "BENCHMARK.md"), "BENCHMARK", benchmark_block)
replace_block(File.join(ROOT, "research", "NOVAPAY_SPEC_ONLY_BASELINE.md"), "NOVAPAY_SPEC_ONLY_BASELINE", baseline_block)
puts "Judge-facing metrics and generated documentation updated"
